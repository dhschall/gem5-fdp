< static inline bool
< isValid(int index)
< {
<     return (index >= Cr0 && index < NumRegs &&
<             index != Cr1 &&
<             !(index > Cr4 && index < Cr8) &&
<             !(index > Cr8 && index <= Cr15));
< }
