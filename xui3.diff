<         if (active_threads > MaxThreads) {
<             panic("Workload Size too large. Increase the 'MaxThreads' "
<                   "constant in cpu/o3/limits.hh or edit your workload size.");
<         }
<     }
< 
<     // Make Sure That this a Valid Architeture
