< IEW::skidCount()
< {
<     int max=0;
< 
<     std::list<ThreadID>::iterator threads = activeThreads->begin();
<     std::list<ThreadID>::iterator end = activeThreads->end();
< 
<     while (threads != end) {
<         ThreadID tid = *threads++;
