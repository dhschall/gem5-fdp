< void
< IEW::takeOverFrom()
< {
<     // Reset all state.
<     _status = Active;
<     exeStatus = Running;
<     wbStatus = Idle;
< 
<     instQueue.takeOverFrom();
<     ldstQueue.takeOverFrom();
<     fuPool->takeOverFrom();
