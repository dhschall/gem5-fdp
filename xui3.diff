<         }
< 
<         o3_tc->cpu = this;
<         o3_tc->thread = thread[tid];
< 
<         // Give the thread the TC.
<         thread[tid]->tc = tc;
< 
<         // Add the TC to the CPU's list of TC's.
<         threadContexts.push_back(tc);
<     }
