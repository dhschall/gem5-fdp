< inline bool
< operator<(const Event &l, const Event &r)
< {
<     return l.when() < r.when() ||
<         (l.when() == r.when() && l.priority() < r.priority());
< }
< 
< /**
<  * @ingroup api_eventq
<  */
< inline bool
< operator>(const Event &l, const Event &r)
< {
<     return l.when() > r.when() ||
<         (l.when() == r.when() && l.priority() > r.priority());
< }
< 
< /**
<  * @ingroup api_eventq
<  */
< inline bool
< operator<=(const Event &l, const Event &r)
< {
<     return l.when() < r.when() ||
<         (l.when() == r.when() && l.priority() <= r.priority());
< }
< 
< /**
<  * @ingroup api_eventq
<  */
< inline bool
< operator>=(const Event &l, const Event &r)
< {
<     return l.when() > r.when() ||
<         (l.when() == r.when() && l.priority() >= r.priority());
< }
< 
< /**
<  * @ingroup api_eventq
<  */
< inline bool
< operator==(const Event &l, const Event &r)
< {
<     return l.when() == r.when() && l.priority() == r.priority();
< }
< 
< /**
<  * @ingroup api_eventq
<  */
< inline bool
< operator!=(const Event &l, const Event &r)
< {
<     return l.when() != r.when() || l.priority() != r.priority();
< }
